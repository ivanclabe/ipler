# Copia este archivo a .env y completa los valores de TU proyecto de Supabase
# (Supabase → Project Settings → API). La URL y la llave deben ser del MISMO proyecto.

VITE_SUPABASE_URL=https://<ref-de-tu-proyecto>.supabase.co

# Llave PÚBLICA del proyecto: la "anon" (empieza por eyJ...) o la "publishable"
# (empieza por sb_publishable_...). Cualquiera de las dos sirve.
# NUNCA pongas aquí la "service_role" ni una "sb_secret_..." — esa solo va en n8n.
VITE_SUPABASE_ANON_KEY=<tu-llave-anon-o-publishable>

# Opcional: enlace de respaldo para "Ver hoja de candidatos" (solo se usa si
# todavía no hay ninguna corrida registrada).
VITE_LEADS_SHEET_URL=
